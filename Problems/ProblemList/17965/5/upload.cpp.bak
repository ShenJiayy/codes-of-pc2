#include <bits/stdc++.h>
using namespace std;
#define int long long
signed main() {
	while (1) {
        int n;
        cin >> n;
        if (n < 3) return 0;
        int sum = 0;
        for (int i = 1; i <= n; i ++)
            for (int j = i + 1; j <= n; j ++) 
                sum += min(i + j - 1, n) - j;
        cout << sum << endl;
    }
    return 0;
}
