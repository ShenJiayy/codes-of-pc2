#include <bits/stdc++.h>
using namespace std;
#define int long long
const int N = 1e5;
int a[N + 5], n, k;

// I WANT IT ACCEPTED, BUT IT CANNOT.
// TEXT IS BELOW
namespace s2 {
	int box[N + 5];
	vector<int> col[N + 5];
}
void solve2() {
	for (int i = 1; i <= n; i ++)
		s2::box[a[i]] ++; // box[i]：颜色i的个数
	int maxn = 0, maxid;
	for (int i = 1; i <= n; i ++)
		if (s2::box[i] > maxn)
			maxn = s2::box[i], maxid = i; // 出现最多的颜色
	int cnt = 0;
	for (int i = 1; i <= n; i ++)
		if (a[i] != maxid)
			s2::col[a[i]].push_back(i);
	for (int i = 1; i <= n; i ++)
		cnt += !s2::col[i].empty();
	cout << cnt << endl;
	for (int i = 1; i <= n; i ++)
		if (!s2::col[i].empty()) {
			cout << s2::col[i].size() << " ";
			for (int j : s2::col[i])
				cout << j << " ";
			cout << maxid << endl;
		}
}

// SHIT THAT CANNOT ACCEPTED
// BELOW 24 LINES, THAT IS.
namespace s3 {
	deque<int> cl[N + 5];
	int vis[N + 5];
}
void solve3() {
	for (int i = 1; i <= n; i ++)
		s3::cl[a[i]].push_back(i), s3::vis[a[i]] = 1;
	int sum = n;
	for (int i = 1; i <= n; i ++)
		if (!s3::cl[i].empty()) 
			s3::cl[i].pop_front(), sum --;
	priority_queue<int, vector<int>, greater<int>> emp;
	for (int i = 1; i <= n; i ++) 
		if (s3::cl[i].empty() && !s3::vis[i])
			emp.push(i);
	cout << sum << endl;
	for (int i = 1; i <= n; i ++)
		if (!s3::cl[i].empty())
			while (!s3::cl[i].empty()) {
				cout << "1 " << s3::cl[i].front() << " " << emp.top() << endl;
				emp.pop();
				s3::cl[i].pop_front();
			}
}

signed main() {
	cin >> n >> k;
	for (int i = 1; i <= n; i ++)
		cin >> a[i];
	if (k == 1)
		solve2();
	else if (k == n)
		solve3(), a[N + 1000] = 1;
    else while (1);
	return 0;
}