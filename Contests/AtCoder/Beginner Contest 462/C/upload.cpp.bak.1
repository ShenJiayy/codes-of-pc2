#include <bits/stdc++.h>
using namespace std;
#define int long long
const int N = 3e5;
int x[N + 5], y[N + 5];
signed main() {
	int n;
    cin >> n;
    for (int i = 1; i <= n; i ++)
        cin >> x[i] >> y[i];
    int cnt = 0;
    for (int i = 1; i <= n; i ++) {
        bool valid = 1;
        for (int j = 1; j <= n; j ++)
            if (1 <= x[j] && x[j] < x[i] && 1 <= y[j] && y[j] < y[i])
                valid = 0;
        cnt += valid;
    }
    cout << cnt;
    return 0;
}
