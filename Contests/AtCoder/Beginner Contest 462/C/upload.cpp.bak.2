#include <bits/stdc++.h>
using namespace std;
#define int long long
const int N = 3e5;
struct pos {
    int x, y;
} a[N + 5];
signed main() {
	int n;
    cin >> n;
    for (int i = 1; i <= n; i ++)
        cin >> a[i].x >> a[i].y;
    int cnt = 0;
    for (int i = 1; i <= n; i ++) {
        bool valid = 1;
        for (int j = 1; j <= n; j ++)
            if (a[j].x < a[i].x && a[j].y < a[i].y)
                valid = 0;
        cnt += valid;
    }
    cout << cnt;
    return 0;
}
