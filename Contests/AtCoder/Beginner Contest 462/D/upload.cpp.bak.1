#include <bits/stdc++.h>
using namespace std;
#define int long long
const int N = 2e5;
struct Line {
    int s, t;
} a[N + 5];
bool cmp(Line x, Line y) {
    if (x.s != y.s) return x.s < y.s;
    return x.t < y.t;
}
signed main() {
	int n, d;
    cin >> n >> d;
    for (int i = 1; i <= n; i ++)
        cin >> a[i].s >> a[i].t;
    int cnt = 0;
    sort(a + 1, a + n + 1, cmp);
    for (int i = 1; i <= n; i ++) 
        for (int j = i + 1; j <= n; j ++) {
            if (a[i].s == a[j].s && a[i].t - a[i].s + 1 >= d) {
                cnt += a[i].t - a[i].s + 1 - d;
                // printf("1 %lld %lld %lld\n", i, j, a[i].t - a[i].s + 1 - d);
            }
            else if (min(a[i].t, a[j].t) - a[j].s + 1 >= d) {
                cnt += min(a[i].t, a[j].t) - a[j].s + 1 - d;
                // printf("2 %lld %lld %lld\n", i, j, min(a[i].t, a[j].t) - a[j].s + 1 - d);
            }
        }
    cout << cnt;
    return 0;
}
