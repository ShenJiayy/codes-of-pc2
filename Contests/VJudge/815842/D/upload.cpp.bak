#include <bits/stdc++.h>
using namespace std;
#define int long long
const int N = 2e3, mod = 998244353;
int a[N + 5], dp[N + 5][N + 5];
signed main() {
	int n;
    cin >> n;
    for (int i = 1; i < n; i ++)
        cin >> a[i];
    dp[n][n] = 1;
    for (int i = n - 1; i >= 1; i --) {
        int t = dp[i + 1][i + a[i]];
        if (a[i] == a[i + 1])
            for (int j = i + 1; j <= n; j ++)
                dp[i][j] = dp[i + 1][j] * (n - 1 - i) % mod,
                dp[i][j] %= mod;
        dp[i][i] += t;
        dp[i][i + a[i]] += t;
    }
    int ans = 0;
    for (int i = 1; i <= n; i ++)
        ans += dp[1][i], ans %= mod;
    cout << ans;
    return 0;
}